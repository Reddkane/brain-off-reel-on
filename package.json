{
  "name": "brain-off-reel-on",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "availability:sweeps": "node scripts/availability-sweeps.ts",
    "test:availability:sweeps:db": "node --test tests/db/availability-sweeps.test.ts tests/db/availability-corrections.test.ts",
    "test:availability:evidence:db": "node --test tests/db/availability-evidence.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.pure.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:db:runner": "node --test tests/db/runner.test.mjs",
    "test:db": "node tooling/db-test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "metadata:dry-run": "node scripts/metadata.ts",
    "ratings:dry-run": "node scripts/ratings.ts",
    "metadata:local": "node tooling/metadata-local.ts",
    "test:metadata:db": "node tooling/metadata-db-test.ts",
    "test:metadata:controls": "node tooling/metadata-mutations.ts",
    "catalog:local": "node scripts/catalog-local.ts",
    "catalog:import": "node scripts/catalog-import.ts",
    "test:catalog:db": "node --test tests/db/catalog.test.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
